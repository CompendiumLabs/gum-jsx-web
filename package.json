{
  "name": "@gum-jsx/web",
  "version": "1.9.0",
  "description": "Browser runtime for gum.jsx: font installation, font embedding, and canvas rasterization",
  "type": "module",
  "author": "Douglas Hanley",
  "homepage": "https://github.com/CompendiumLabs/gum-jsx-web",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CompendiumLabs/gum-jsx-web.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "types"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.ts"
    },
    "./fonts": {
      "types": "./types/fonts.d.ts",
      "import": "./src/fonts.ts"
    },
    "./embed": {
      "types": "./types/embed.d.ts",
      "import": "./src/embed.ts"
    },
    "./raster": {
      "types": "./types/raster.d.ts",
      "import": "./src/raster.ts"
    },
    "./files": {
      "types": "./types/files.d.ts",
      "import": "./src/files.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "bun ./scripts/test.ts",
    "typecheck": "bun tsc --noEmit",
    "types": "rm -rf types && bun tsc -p tsconfig.types.json",
    "prepublishOnly": "bun run types"
  },
  "peerDependencies": {
    "@gum-jsx/core": "^1.9.0"
  },
  "devDependencies": {
    "@gum-jsx/core": "^1.9.0",
    "@gum-jsx/math": "^1.9.0",
    "@types/node": "^25.2.3",
    "typescript": "^5.9.3"
  }
}
