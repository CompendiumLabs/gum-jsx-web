{
  "name": "@gum-jsx/web",
  "version": "1.7.0",
  "description": "Browser runtime for gum.jsx: font installation, font embedding, and canvas rasterization",
  "type": "module",
  "author": "Douglas Hanley",
  "homepage": "https://github.com/CompendiumLabs/gum-jsx-web",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CompendiumLabs/gum-jsx-web.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./fonts": "./src/fonts.ts",
    "./embed": "./src/embed.ts",
    "./raster": "./src/raster.ts",
    "./files": "./src/files.ts",
    "./gif": "./src/gif.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "bun ./scripts/test.ts",
    "typecheck": "bun tsc --noEmit"
  },
  "peerDependencies": {
    "@gum-jsx/core": "^1.7.0"
  },
  "dependencies": {
    "gifenc": "^1.0.3"
  },
  "devDependencies": {
    "@gum-jsx/core": "^1.7.0",
    "@gum-jsx/math": "^1.7.0",
    "@types/node": "^25.2.3",
    "typescript": "^5.9.3"
  }
}
